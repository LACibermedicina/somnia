# Copie para .env e ajuste. Nunca versione o .env nem compartilhe seus valores.
# Na VPS, deploy/setup-vps.sh gera este arquivo automaticamente por ambiente.
AMBIENTE=producao
CONTAINER=somnia-app
PORT_HOST=3401
DATA_PATH=/var/lib/somnia
PORT=3000
# 127.0.0.1 quando houver Nginx na frente; 0.0.0.0 em Docker
HOST=127.0.0.1
COOKIE_SECURE=true
TRUST_PROXY=true
DATA_DIR=/var/lib/somnia
# Homologação: BASE_PATH=/teste e COOKIE_NAME=somnia_sid_teste (vazio em produção)
BASE_PATH=
COOKIE_NAME=somnia_sid
# Usada SOMENTE no primeiro boot, para criar o usuário "root" (12+ caracteres).
# Na VPS fica em .env.gerado (gerada aleatoriamente). Trocas futuras: npm run reset-root
ROOT_PASSWORD=troque-por-uma-senha-longa-e-unica
# IA (tradução contextual, flashcards, guia Lume, estúdio). Na VPS vem do secret SERVIDOR_ENV -> .env.segredos
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PER_HOUR=30
I18N_PER_HOUR=60
GUIA_PER_HOUR=20
