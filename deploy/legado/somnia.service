[Unit]
Description=Somnia
After=network.target

[Service]
User=somnia
Group=somnia
WorkingDirectory=/opt/somnia
EnvironmentFile=/opt/somnia/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/somnia

[Install]
WantedBy=multi-user.target
